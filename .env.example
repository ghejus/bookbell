# Copy this file to .env.local and fill in the values. Never share .env.local.

# Supabase: Dashboard -> Project Settings -> API Keys (and Data API for the URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Where the site lives. Used in "confirm your email" links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The chat helper on each shop's page (optional).
# Empty: "practice mode", a simple free helper with no AI.
# A Claude key from https://platform.claude.com (Settings -> API keys) turns on the real AI helper.
ANTHROPIC_API_KEY=
# Set to "practice" to force practice mode even when a key is set.
AI_PROVIDER=

# Emails (optional). Empty: emails are only written to the server log.
# A Gmail address plus an "app password" (Google Account -> Security ->
# 2-Step Verification -> App passwords) turns on real emails.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# The server's own Supabase key (Dashboard -> Project Settings -> API Keys ->
# Secret keys). Used for the daily reminder emails, the daily email limit and
# finding shop owners' emails. Never put it in code or share it.
SUPABASE_SECRET_KEY=

# Any long random text. Vercel sends it when it runs the daily reminder job,
# so nobody else can start it.
CRON_SECRET=
